# Copy to .env and fill in. .env is gitignored and read by docker compose.
#
# Google Drive OAuth credentials for the DB backup uploads.
# These bind the backups to a specific Google account -- generate them
# while signed into your PERSONAL account so the files land there.
#
# 1. Google Cloud Console (personal account): create a project, enable the
#    Drive API, configure the OAuth consent screen (External, add yourself
#    as a test user), then create an OAuth client ID of type "Desktop app".
#    That gives you the client id and secret below.
# 2. Mint a refresh token by running the one-time helper (see
#    scripts/gdrive_auth.py) signed in as your personal account.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=

# Optional: leave blank to auto-create a "budgeting-backups" folder on the
# first push (its id is printed so you can pin it here afterwards).
GDRIVE_FOLDER_ID=
